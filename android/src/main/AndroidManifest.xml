<?xml version="1.0" encoding="utf-8"?>
<!--
  给 AGP < 7.3（RN 0.67 / 0.68 时代）使用的 manifest —— 那时还没有 namespace DSL，
  包名必须写在这里。AGP >= 7.3 会改用 AndroidManifestNew.xml，见 build.gradle。
  两份文件除了 package= 之外必须保持一致。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.syanpicker">

    <!--
      不加 maxSdkVersion="32"。PictureSelector 在 Android 13+ 上按宿主 targetSdk 选权限：
      targetSdk < 33 时仍申请 READ_EXTERNAL_STORAGE。库里写了 maxSdkVersion，合并后
      这类宿主在 13+ 上没有声明该权限，申请直接被拒，相册打不开。
    -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <!-- Android 13+ 的分类媒体权限 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />

    <!-- Android 14+ 的"仅选择部分照片" -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <!--
      必须声明 CAMERA。

      裸的 ACTION_IMAGE_CAPTURE Intent 确实不需要这个权限，但本库走的是
      PictureSelector，它在拉起相机前会执行
      PermissionChecker.isCheckCamera() → checkSelfPermission(CAMERA)。
      而 Android 对**未在清单中声明**的权限一律直接返回 DENIED 且不弹授权框，
      不声明的话 captureImage / captureVideo / 相册内的相机入口全部打不开。
    -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
      Android 11+ 包可见性：不声明的话 resolveActivity(IMAGE_CAPTURE) 常为 null，
      PictureSelector 会静默跳过 startActivityForResult，相机永远不出现。
    -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.media.action.VIDEO_CAPTURE" />
        </intent>
        <!-- 系统 Photo Picker：判断是否可用时要 resolveActivity(PICK_IMAGES)。 -->
        <intent>
            <action android:name="android.provider.action.PICK_IMAGES" />
            <data android:mimeType="image/*" />
        </intent>
    </queries>

</manifest>
