{
  "name": "react-native-syan-image-picker",
  "version": "1.0.0",
  "description": "React Native 多图片选择组件，支持裁剪与压缩",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/src/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "RNSyanImagePicker.podspec",
    "!android/build",
    "!android/.gradle",
    "!ios/tests",
    "!**/__tests__",
    "README.md",
    "MIGRATION.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src __tests__ example",
    "test": "jest",
    "clean": "del-cli lib",
    "prepare": "bob build"
  },
  "keywords": [
    "react-native",
    "image",
    "image-picker",
    "video-picker",
    "syan",
    "PictureSelector",
    "TZImagePickerController",
    "photo"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syanbo/react-native-syan-image-picker.git"
  },
  "homepage": "https://github.com/syanbo/react-native-syan-image-picker#readme",
  "bugs": {
    "url": "https://github.com/syanbo/react-native-syan-image-picker/issues"
  },
  "author": "syan",
  "license": "MIT",
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@react-native/babel-preset": "0.86.2",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.0",
    "babel-jest": "^30.4.1",
    "del-cli": "^7.0.0",
    "eslint": "^9.0.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "react": "19.2.8",
    "react-native": "0.86.2",
    "react-native-builder-bob": "^0.43.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      "typescript"
    ]
  },
  "jest": {
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/lib/",
      "/example"
    ]
  }
}
